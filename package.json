{
  "name": "courier-tracking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregator API to fetch shipment status from iMile, Injaz Express, J&T Express, and JDW Logistics.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit",
    "test": "tsx src/normalize.test.ts && tsx src/bulk.test.ts && tsx src/jt-batch.test.ts && tsx src/jt-trackingmore.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/express": "^3.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.0.0",
    "express": "^4.22.2",
    "fastify": "^4.28.1",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.3.1",
    "opencv-wasm": "^4.3.0-10",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.10",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
